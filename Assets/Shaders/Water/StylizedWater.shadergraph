    },
    "m_Name": "GerstnerWaves (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 1153.0001220703125,
            "y": -256.0000305175781,
            "width": 228.0,
            "height": 334.0000305175781
        }
    },
    "m_Slots": [
        {
            "m_Id": "4edf15471f6c45f09c28ab4922f3ee2d"
        },
        {
            "m_Id": "df7c8eb375084a4e8e50818b0f3f9afe"
        },
        {
            "m_Id": "b061dfbca1dd459a97660ced018752b7"
        },
        {
            "m_Id": "792999930f504dfbaee95d1326c2bf8a"
        },
        {
            "m_Id": "4c8f4f1c1cd344a5a67c87b4ca15307e"
        },
        {
            "m_Id": "9115cd5d170a4e0895fb695b1413a886"
        },
        {
            "m_Id": "d0e0935f80fc4e46beb67c1da7187e81"
        },
        {
            "m_Id": "a1fad5efb96c40b7b8f867b9601c4dd0"
        },
        {
            "m_Id": "c24a51c564624518bc33dd974ac92207"
        },
        {
            "m_Id": "a79b62afc4144122bbc18b6ee2002dbe"
        },
        {
            "m_Id": "b16c954c5d934221bb0db272cef6c30e"
        },
        {
            "m_Id": "9498b4a2fe3c4317be07ab96b94dfcde"
        },
        {
            "m_Id": "a3b1909c6b20432095627f5096aafc7a"
        },
        {
            "m_Id": "eb7e77a9a7f94739917012fc01a0ffc1"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GerstnerWaves",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 pos = PositionOS;\nfloat3 normal = float3(0, 1, 0);\n\nfloat timeScaled = Time * WaveSpeed;\n\nfloat2 D1 = normalize(Wave1Dir + float2(0.001, 0.001));\nfloat k1 = (2.0 * 3.14159265) / max(Wave1Len, 0.01);\nfloat f1 = k1 * (dot(D1, PositionOS.xz) - timeScaled);\nfloat cosF1 = cos(f1);\nfloat sinF1 = sin(f1);\n\npos.x += Wave1Steep * Wave1Amp * D1.x * cosF1;\npos.y += Wave1Amp * sinF1;\npos.z += Wave1Steep * Wave1Amp * D1.y * cosF1;\n\nnormal.x += -D1.x * Wave1Amp * k1 * cosF1;\nnormal.y += -Wave1Steep * Wave1Amp * k1 * sinF1;\nnormal.z += -D1.y * Wave1Amp * k1 * cosF1;\n\nfloat2 D2 = normalize(Wave2Dir + float2(0.001, 0.001));\nfloat k2 = (2.0 * 3.14159265) / max(Wave2Len, 0.01);\nfloat f2 = k2 * (dot(D2, PositionOS.xz) - timeScaled);\nfloat cosF2 = cos(f2);\nfloat sinF2 = sin(f2);\n\npos.x += Wave2Steep * Wave2Amp * D2.x * cosF2;\npos.y += Wave2Amp * sinF2;\npos.z += Wave2Steep * Wave2Amp * D2.y * cosF2;\n\nnormal.x += -D2.x * Wave2Amp * k2 * cosF2;\nnormal.y += -Wave2Steep * Wave2Amp * k2 * sinF2;\nnormal.z += -D2.y * Wave2Amp * k2 * cosF2;\n\nOutPosition = pos;\nOutNormal = normalize(normal);\nfloat3 up = float3(0, 1, 0);\nOutTangent = normalize(cross(up, OutNormal));\n"
}

