  <Replicas>k__BackingField:
  - <Text>k__BackingField: "\u0422\u0435\u043F\u0435\u0440\u044C \u0434\u0432\u0435
      \u0441\u0442\u0435\u043D\u044B \u0441 \u0442\u043E\u0447\u043A\u0430\u043C\u0438
      \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E.\r\n"
    <Audio>k__BackingField: {fileID: 8300000, guid: 133fe4e1888239641945e9ef74df11db, type: 3}
  - <Text>k__BackingField: "\u0421\u043B\u0435\u0432\u0430 \u2014 \u0440\u044F\u0434
      \u0438\u0437 3 \u0431\u043B\u043E\u043A\u043E\u0432, \u0441\u043F\u0440\u0430\u0432\u0430
      \u2014 \u0440\u044F\u0434 \u0438\u0437 2 \u0431\u043B\u043E\u043A\u043E\u0432.\r\n"
    <Audio>k__BackingField: {fileID: 8300000, guid: aedb3af8e812e3f4b9e65422665bd7cc, type: 3}
  - <Text>k__BackingField: "\u0421\u0432\u0435\u0440\u044C\u0441\u044F \u0441 \u043E\u0431\u0435\u0438\u043C\u0438
      \u0441\u0442\u0435\u043D\u0430\u043C\u0438, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0431\u043B\u043E\u043A\u0438.\r\n"
    <Audio>k__BackingField: {fileID: 8300000, guid: c308813553678a342b2ba978e4a70e2d, type: 3}
