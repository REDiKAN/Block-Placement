  m_Script: {fileID: 11500000, guid: cd64ad8b1fdea3643a7ca4da3ebc9d49, type: 3}
  m_Name: LevelTutorial (StructureHoles) (15)_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::Game.Data.DialogueConfig
  <Replicas>k__BackingField:
  - <Text>k__BackingField: "\u0421\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u044B,
      \u043A\u0430\u043A \u0438 \u043E\u0431\u044B\u0447\u043D\u044B\u0435 \u0431\u043B\u043E\u043A\u0438,
      \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u0441\u0442\u043E\u044F\u0442\u044C
      \u043D\u0430\u0434 \u0434\u044B\u0440\u0430\u043C\u0438."
    <Audio>k__BackingField: {fileID: 0}
  - <Text>k__BackingField: "\u0415\u0441\u043B\u0438 \u0445\u043E\u0442\u044C \u043E\u0434\u0438\u043D
      \u0431\u043B\u043E\u043A \u0444\u0438\u0433\u0443\u0440\u044B \u043F\u043E\u043F\u0430\u0434\u0430\u0435\u0442
      \u043D\u0430\u0434 \u043F\u0443\u0441\u0442\u043E\u0442\u043E\u0439 \u2014
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0435\u0451 \u043D\u0435
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F."
    <Audio>k__BackingField: {fileID: 0}
  - <Text>k__BackingField: "\u0420\u0430\u0437\u043C\u0435\u0441\u0442\u0438 \u043E\u0431\u0435
      \u0430\u0440\u043A\u0438, \u043E\u0431\u0445\u043E\u0434\u044F \u043A\u0440\u0435\u0441\u0442\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u0443\u044E
      \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C \u0432 \u0446\u0435\u043D\u0442\u0440\u0435."
    <Audio>k__BackingField: {fileID: 0}
