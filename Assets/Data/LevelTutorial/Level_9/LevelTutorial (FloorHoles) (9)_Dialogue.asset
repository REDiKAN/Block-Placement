  <Replicas>k__BackingField:
  - <Text>k__BackingField: "\u041D\u0435 \u0432\u0435\u0441\u044C \u043F\u043E\u043B
      \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u0439 \u2014 \u0432 \u0446\u0435\u043D\u0442\u0440\u0435
      \u0435\u0441\u0442\u044C \u0434\u044B\u0440\u044B.\r\n"
    <Audio>k__BackingField: {fileID: 8300000, guid: d6fe690adddd71140aa7a2b6616c7d1f, type: 3}
  - <Text>k__BackingField: "\u041D\u0430\u0434 \u0442\u0451\u043C\u043D\u044B\u043C\u0438
      \u043A\u043B\u0435\u0442\u043A\u0430\u043C\u0438 \u0431\u043B\u043E\u043A\u0438
      \u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043D\u0435\u043B\u044C\u0437\u044F,
      \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u0442\u0430\u043C \u0435\u0441\u0442\u044C
      \u0442\u0435\u043D\u044C.\r\n"
    <Audio>k__BackingField: {fileID: 8300000, guid: 3f8aec914c72663419df93d677472196, type: 3}
  - <Text>k__BackingField: "\u041F\u043E\u0441\u0442\u0440\u043E\u0439 4 \u0431\u043B\u043E\u043A\u0430
      \u043F\u043E \u0443\u0433\u043B\u0430\u043C, \u043E\u0431\u0445\u043E\u0434\u044F
      \u043F\u0443\u0441\u0442\u043E\u0442\u0443."
