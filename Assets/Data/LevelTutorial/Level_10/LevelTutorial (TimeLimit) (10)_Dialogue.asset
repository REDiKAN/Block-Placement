  <Replicas>k__BackingField:
  - <Text>k__BackingField: "\u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0443\u0436\u043D\u043E
      \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0431\u044B\u0441\u0442\u0440\u043E!\r\n"
    <Audio>k__BackingField: {fileID: 8300000, guid: 87b13d2442af6fe44a609aa9ff49997a, type: 3}
  - <Text>k__BackingField: "\u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u0442\u0430\u0439\u043C\u0435\u0440\u043E\u043C
      \u0432\u0432\u0435\u0440\u0445\u0443 \u044D\u043A\u0440\u0430\u043D\u0430 -
      \u043E\u043D \u043C\u0435\u043D\u044F\u0435\u0442 \u0446\u0432\u0435\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043C\u0430\u043B\u043E."
    <Audio>k__BackingField: {fileID: 8300000, guid: b6f0b03f9a304694ea0843e3922529e9, type: 3}
  - <Text>k__BackingField: "\u0423 \u0442\u0435\u0431\u044F 30 \u0441\u0435\u043A\u0443\u043D\u0434,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C
      \u0434\u043B\u0438\u043D\u043D\u044B\u0439 \u0440\u044F\u0434 \u0438\u0437
      5 \u0431\u043B\u043E\u043A\u043E\u0432."
    <Audio>k__BackingField: {fileID: 8300000, guid: 66937b4e60cfe434d9e5755cf8135581, type: 3}
