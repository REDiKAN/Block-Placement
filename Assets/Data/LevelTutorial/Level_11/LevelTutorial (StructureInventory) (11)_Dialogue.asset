  <Replicas>k__BackingField:
  - <Text>k__BackingField: "\u0422\u0435\u043F\u0435\u0440\u044C \u0442\u044B \u0441\u0442\u0440\u043E\u0438\u0448\u044C
      \u0446\u0435\u043B\u044B\u043C\u0438 \u0444\u0438\u0433\u0443\u0440\u0430\u043C\u0438,
      \u0430 \u043D\u0435 \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u0431\u043B\u043E\u043A\u0443."
    <Audio>k__BackingField: {fileID: 0}
  - <Text>k__BackingField: "\u0421\u043B\u0435\u0432\u0430 \u2014 \u043F\u0430\u043D\u0435\u043B\u044C
      \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044F. \u0422\u0430\u043C
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430 L-\u043E\u0431\u0440\u0430\u0437\u043D\u0430\u044F
      \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430."
    <Audio>k__BackingField: {fileID: 0}
  - <Text>k__BackingField: "\u0412\u044B\u0431\u0435\u0440\u0438 \u0435\u0451 \u0438
      \u043F\u043E\u0441\u0442\u0430\u0432\u044C \u0434\u0432\u0435 L-\u0444\u0438\u0433\u0443\u0440\u044B,
      \u0447\u0442\u043E\u0431\u044B \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0442\u0435\u043D\u0438."
    <Audio>k__BackingField: {fileID: 0}
