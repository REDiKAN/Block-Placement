  <Replicas>k__BackingField:
  - <Text>k__BackingField: "\u0418\u043D\u043E\u0433\u0434\u0430 \u043C\u044B \u043E\u0448\u0438\u0431\u0430\u0435\u043C\u0441\u044F
      \u2014 \u0438 \u044D\u0442\u043E \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E"
    <Audio>k__BackingField: {fileID: 8300000, guid: fd3ab4eed6c378540a893d8f710ef30f, type: 3}
  - <Text>k__BackingField: "\u0415\u0441\u043B\u0438 \u0442\u044B \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u0431\u043B\u043E\u043A \u043D\u0435 \u0442\u0443\u0434\u0430, \u043D\u0430\u0436\u043C\u0438
      \u043F\u0440\u0430\u0432\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438
      \u2014 \u044D\u0442\u043E \u043E\u0442\u043C\u0435\u043D\u0438\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435."
    <Audio>k__BackingField: {fileID: 8300000, guid: 7adc4d2bc9d1ee0439c4aa7a2221fbb0, type: 3}
  - <Text>k__BackingField: "\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439: \u043F\u043E\u0441\u0442\u0430\u0432\u044C
      \u0431\u043B\u043E\u043A, \u0430 \u043F\u043E\u0442\u043E\u043C \u0443\u0431\u0435\u0440\u0438
      \u0435\u0433\u043E \u0447\u0435\u0440\u0435\u0437 \u041F\u041A\u041C."
    <Audio>k__BackingField: {fileID: 8300000, guid: 5b73a980112c5ca4fa2133dbc5a36070, type: 3}
