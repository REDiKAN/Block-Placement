  m_Name: LevelTutorial (Density) (6)_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::Game.Data.DialogueConfig
  <Replicas>k__BackingField:
  - <Text>k__BackingField: "\u0412\u0438\u0434\u0438\u0448\u044C \u0442\u043E\u0447\u043A\u0438
      \u043D\u0430 \u0441\u0442\u0435\u043D\u0435? \u041E\u043D\u0430 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442,
      \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0431\u043B\u043E\u043A\u043E\u0432
      \u0441\u0442\u043E\u0438\u0442 \u0432 \u044D\u0442\u043E\u0439 \u043A\u043E\u043B\u043E\u043D\u043D\u0435.\r\n"
    <Audio>k__BackingField: {fileID: 8300000, guid: 707b51b75c7f28a44ae995f95818f3a5, type: 3}
  - <Text>k__BackingField: "\u0417\u0434\u0435\u0441\u044C \u043D\u0443\u0436\u043D\u043E
      \u0440\u043E\u0432\u043D\u043E 3 \u0431\u043B\u043E\u043A\u0430 \u0432 \u043E\u0434\u043D\u043E\u043C
      \u0440\u044F\u0434\u0443.\r\n"
    <Audio>k__BackingField: {fileID: 8300000, guid: 96d13733402f3d048876d1600ac017a6, type: 3}
  - <Text>k__BackingField: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u0438\u0445
      \u043E\u0434\u0438\u043D \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u043C,
      \u0447\u0442\u043E\u0431\u044B \u0447\u0438\u0441\u043B\u043E \u043D\u0430
      \u0441\u0442\u0435\u043D\u0435 \u0441\u0442\u0430\u043B\u043E \u0437\u0435\u043B\u0451\u043D\u044B\u043C.\r\n"
    <Audio>k__BackingField: {fileID: 8300000, guid: ebae4ce3428078145816d02ab6f121f6, type: 3}
