  m_Name: LevelTutorial (FinalExam) (16)_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::Game.Data.DialogueConfig
  <Replicas>k__BackingField:
  - <Text>k__BackingField: "\u0412\u0440\u0435\u043C\u044F \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C,
      \u0447\u0435\u043C\u0443 \u0442\u044B \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F.
      \u042D\u0442\u043E \u0432\u044B\u043F\u0443\u0441\u043A\u043D\u043E\u0439 \u044D\u043A\u0437\u0430\u043C\u0435\u043D."
    <Audio>k__BackingField: {fileID: 0}
  - <Text>k__BackingField: "\u041E\u0434\u043D\u0430 \u0441\u0442\u0435\u043D\u0430
      \u0441 \u0446\u0438\u0444\u0440\u0430\u043C\u0438, \u0434\u0440\u0443\u0433\u0430\u044F
      \u0441 \u0442\u0435\u043D\u044F\u043C\u0438. \u0412 \u043F\u043E\u043B\u0443
      \u0434\u044B\u0440\u044B. \u0423 \u0442\u0435\u0431\u044F 60 \u0441\u0435\u043A\u0443\u043D\u0434."
    <Audio>k__BackingField: {fileID: 0}
  - <Text>k__BackingField: "\u0423\u0434\u0430\u0447\u0438, \u0438\u0441\u043A\u0430\u0442\u0435\u043B\u044C
      \u0442\u0435\u043D\u0435\u0439."
    <Audio>k__BackingField: {fileID: 0}
