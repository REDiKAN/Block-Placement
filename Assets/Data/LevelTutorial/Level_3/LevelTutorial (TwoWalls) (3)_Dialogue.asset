  <Replicas>k__BackingField:
  - <Text>k__BackingField: "\u0422\u0435\u043F\u0435\u0440\u044C \u0441\u043C\u043E\u0442\u0440\u0438
      \u043D\u0430 \u043E\u0431\u0435 \u0441\u0442\u0435\u043D\u044B \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E."
    <Audio>k__BackingField: {fileID: 8300000, guid: 99922510204085640850fce83a011f1c, type: 3}
  - <Text>k__BackingField: "\u0411\u043B\u043E\u043A \u0434\u043E\u043B\u0436\u0435\u043D
      \u0441\u0442\u043E\u044F\u0442\u044C \u0432 \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043D\u0438\u0438
      \u0442\u0435\u043D\u0435\u0439 \u0441 \u0434\u0432\u0443\u0445 \u0441\u0442\u043E\u0440\u043E\u043D."
    <Audio>k__BackingField: {fileID: 8300000, guid: 1cf7c8985a8df744fa9bf0d7065fda25, type: 3}
  - <Text>k__BackingField: "\u0421\u043E\u0431\u0435\u0440\u0438 \u0413-\u043E\u0431\u0440\u0430\u0437\u043D\u0443\u044E
