  <Replicas>k__BackingField:
  - "\u0421\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \u0446\u0438\u0444\u0440\u044B
    \u0440\u044F\u0434\u043E\u043C \u0441\u043E \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430\u043C\u0438
    \u0432 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435"
  - "\u042D\u0442\u043E \u043B\u0438\u043C\u0438\u0442. \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0435\u0441\u043B\u0438 \u0442\u0430\u043C \u0441\u0442\u043E\u0438\u0442 '1',
    \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \n\u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u044D\u0442\u0443 \u0444\u0438\u0433\u0443\u0440\u0443 \u043B\u0438\u0448\u044C
    \u0435\u0434\u0438\u043D\u043E\u0436\u0434\u044B"
  - "\u041A\u043E\u0433\u0434\u0430 \u043B\u0438\u043C\u0438\u0442 \u0438\u0441\u0447\u0435\u0440\u043F\u0430\u043D,
    \u0438\u043A\u043E\u043D\u043A\u0430 \u0441\u0442\u0430\u043D\u0435\u0442 \u043D\u0435\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0439"
  - "\u0414\u0443\u043C\u0430\u0439 \u043D\u0430 \u0448\u0430\u0433 \u0432\u043F\u0435\u0440\u0435\u0434
    \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0440\u0435\u0441\u0443\u0440\u0441\u044B
    \u0441 \u0443\u043C\u043E\u043C!"
