  <Replicas>k__BackingField:
  - "\u0412\u0440\u0435\u043C\u044F \u043F\u043E\u0448\u043B\u043E! \u23F1\uFE0F
    \u0412\u0438\u0434\u0438\u0448\u044C \u0448\u043A\u0430\u043B\u0443 \u0432 \u0443\u0433\u043B\u0443
    \u044D\u043A\u0440\u0430\u043D\u0430"
  - "\u041D\u0430 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0443\u0440\u043E\u0432\u043D\u044F\u0445
    \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u0443\u0441\u043F\u0435\u0442\u044C
    \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u0444\u0438\u0433\u0443\u0440\u0443
    \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u043E\u0442\u0441\u0447\u0435\u0442\u0430"
  - "\u0415\u0441\u043B\u0438 \u0432\u0440\u0435\u043C\u044F \u0432\u044B\u0439\u0434\u0435\u0442,
    \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
    \u043D\u0430\u0447\u0430\u0442\u044C \u0437\u0430\u043D\u043E\u0432\u043E"
  - "\u041D\u0435 \u043F\u0430\u043D\u0438\u043A\u0443\u0439, \u0432\u0440\u0435\u043C\u0435\u043D\u0438
    \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E. \u0421\u043E\u0431\u0435\u0440\u0438\u0441\u044C
    \u0438 \u043D\u0430\u0447\u043D\u0438!"
